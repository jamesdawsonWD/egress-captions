LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Recording (optional). Without TEMPLATE_PUBLIC_URL and S3_BUCKET, calls work but aren't recorded.
# Any S3-compatible storage works; set S3_ENDPOINT for providers other than AWS.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET=
S3_ENDPOINT=
TEMPLATE_PUBLIC_URL=
